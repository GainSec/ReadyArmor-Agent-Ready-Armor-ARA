#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"
ROOT="$(cd -- "$HERE/.." &> /dev/null && pwd)"
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"

# Pick a Python >=3.9. Honor $ARA_PYTHON first, then probe.
if [[ -n "${ARA_PYTHON:-}" ]]; then
  PY="$ARA_PYTHON"
else
  PY=""
  for candidate in python3.14 python3.13 python3.12 python3.11 python3.10 python3.9 python3; do
    if command -v "$candidate" > /dev/null 2>&1; then
      v=$("$candidate" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")' 2>/dev/null || echo "")
      major=${v%.*}
      minor=${v#*.}
      if [[ "$major" == "3" && -n "$minor" && "$minor" -ge 9 ]]; then
        PY="$candidate"
        break
      fi
    fi
  done
  if [[ -z "$PY" ]]; then
    echo "ara: no Python >=3.9 found" >&2
    exit 1
  fi
fi

exec "$PY" -m ara.cli "$@"
