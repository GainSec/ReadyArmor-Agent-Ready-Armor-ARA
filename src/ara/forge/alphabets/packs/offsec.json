      "prompt_fragment": "Halted for operator. Agent does not act here.",
      "tool_surface": [],
      "exits": {},
      "can_emit_finding": false,
      "is_terminal": true,
      "is_entry": false,
      "gems": [
        {
          "layer": "net",
          "rule_subset": "paused",
          "inhibition_level": 1.0,
          "scope": "strict"
        },
        {
          "layer": "exec",
          "rule_subset": "paused",
          "inhibition_level": 1.0,
          "scope": "strict"
        },
        {
          "layer": "fs",
          "rule_subset": "paused",
          "inhibition_level": 1.0,
          "scope": "strict"
        },
        {
          "layer": "reply",
          "rule_subset": "operator_review_reply",
          "inhibition_level": 1.0,
          "scope": "strict"
        }
      ]
    }
  ]
}
